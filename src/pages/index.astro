---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const compare = (await getCollection('compare')).sort(
  (a, b) => a.data.order - b.data.order
);
const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
  title="The UK Punter — Independent UKGC Casino Comparisons & Guides"
  description="Compare UKGC-licensed casinos by payout speed, PayPal support, minimum deposit and RTP. Independent, data-driven guides for UK players. 18+."
>
  <section class="hero">
    <div class="container">
      <h1>Find the right UK casino — compared on the things that actually matter</h1>
      <p class="lead">
        Payout policies, certified RTP figures, deposit minimums and bonus terms — researched
        and compared across UKGC-licensed sites only. No hype, no unlicensed operators.
      </p>
      <a class="hero-cta" href="/fastest-withdrawal-casinos-uk/">Compare payout policies</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">UKGC-licensed casinos we cover</h2>
      <p class="section-sub">
        Established UK brands, every one licensed by the UK Gambling Commission. We don't accept
        payment for placement — see <a href="/about/">how we research</a>.
      </p>
      <div class="brand-grid">
        <div class="brand-card">
          <h3>bet365 Casino</h3>
          <p class="brand-meta">Hillside (UK New Media) group</p>
          <p>Broad game library, £5 minimum deposits and one of the widest live lobbies in the UK.</p>
          <a href="/best-paypal-casinos-uk/">Featured in: PayPal casinos &rarr;</a>
        </div>
        <div class="brand-card">
          <h3>Sky Vegas</h3>
          <p class="brand-meta">Bonne Terre Limited</p>
          <p>Household-name brand known for wager-free promotions and low £5 deposits.</p>
          <a href="/no-wagering-bonus-casinos-uk/">Featured in: No wagering bonuses &rarr;</a>
        </div>
        <div class="brand-card">
          <h3>PlayOJO</h3>
          <p class="brand-meta">SkillOnNet Ltd</p>
          <p>All promotions wager-free as standing policy; markets "no pending period" withdrawals.</p>
          <a href="/fastest-withdrawal-casinos-uk/">Featured in: Withdrawal policies &rarr;</a>
        </div>
        <div class="brand-card">
          <h3>Betfair Casino</h3>
          <p class="brand-meta">PPB Entertainment group</p>
          <p>Exchange heritage with a wide live casino range and PayPal support.</p>
          <a href="/best-paypal-casinos-uk/">Featured in: PayPal casinos &rarr;</a>
        </div>
        <div class="brand-card">
          <h3>William Hill</h3>
          <p class="brand-meta">WHG (International) group</p>
          <p>High-street heritage, large blackjack spread and game shows in the live lobby.</p>
          <a href="/live-dealer-casinos-uk/">Featured in: Live dealer casinos &rarr;</a>
        </div>
        <div class="brand-card">
          <h3>Grosvenor Casino</h3>
          <p class="brand-meta">Rank Digital Gaming</p>
          <p>UK-facing Evolution tables backed by decades of physical casino experience.</p>
          <a href="/live-dealer-casinos-uk/">Featured in: Live dealer casinos &rarr;</a>
        </div>
        <div class="brand-card">
          <h3>MrQ</h3>
          <p class="brand-meta">Lindar Media Ltd</p>
          <p>Built its brand on wager-free free spins with plain-English terms.</p>
          <a href="/no-wagering-bonus-casinos-uk/">Featured in: No wagering bonuses &rarr;</a>
        </div>
        <div class="brand-card">
          <h3>Virgin Games</h3>
          <p class="brand-meta">Gamesys Operations group</p>
          <p>Casual-friendly design with community promotions and PayPal support.</p>
          <a href="/best-paypal-casinos-uk/">Featured in: PayPal casinos &rarr;</a>
        </div>
      </div>
      <p class="brand-note">
        18+. Operator details reflect published terms at the time of our last review — always
        confirm in the operator's own cashier and terms. Please gamble responsibly.
      </p>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <h2 class="section-title">Casino comparisons</h2>
      <p class="section-sub">
        High-intent comparisons for UK players, updated whenever terms change.
      </p>
      <div class="card-grid">
        {compare.map((page) => (
          <div class="card">
            <span class="card-tag">Comparison</span>
            <h3><a href={`/${page.id}/`}>{page.data.h1}</a></h3>
            <p>{page.data.description}</p>
            <a class="card-link" href={`/${page.id}/`}>Read the comparison &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Guides for UK players</h2>
      <p class="section-sub">
        Plain-English answers to the questions UK players actually search for.
      </p>
      <div class="card-grid">
        {guides.map((guide) => (
          <div class="card">
            <span class="card-tag">Guide</span>
            <h3><a href={`/guides/${guide.id}/`}>{guide.data.h1}</a></h3>
            <p>{guide.data.description}</p>
            <a class="card-link" href={`/guides/${guide.id}/`}>Read the guide &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <h2 class="section-title">Why trust The UK Punter?</h2>
      <div class="card-grid">
        <div class="card">
          <h3>UKGC-licensed only</h3>
          <p>
            Every operator we feature holds a UK Gambling Commission licence. That means your
            funds are protected, games are independently tested, and you have access to free
            dispute resolution.
          </p>
        </div>
        <div class="card">
          <h3>Published terms, checked properly</h3>
          <p>
            Our comparisons are built from operators' published cashier terms, bonus conditions
            and the regulator's own market data — read in full, re-checked regularly, and never
            copied from a press release.
          </p>
        </div>
        <div class="card">
          <h3>Safer gambling first</h3>
          <p>
            We explain stake limits, deposit limits and self-exclusion honestly. Gambling is
            entertainment, not income — and we never pretend otherwise.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
